# Copie ce fichier en .env pour un test local — .env n'est JAMAIS commité.
# En production, ces variables se règlent dans Netlify :
#   Site configuration → Environment variables → scope « Functions »

# Clé Gemini au format AIza… (une clé AQ.… est refusée par l'API : 401 ACCESS_TOKEN_TYPE_UNSUPPORTED)
GEMINI_API_KEY=

# Optionnels — valeurs par défaut dans le code
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_API_VERSION=v1alpha
# GEMINI_TOKENS_PER_HOUR=12
